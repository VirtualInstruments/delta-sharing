#! groovy

MAKE='make -f ci/Makefile'

node('docker-big') {
    currentBuild.displayName = "PR #${env.ghprbPullId}@${env.NODE_NAME}"
    configFileProvider([
        configFile(fileId: 'global', variable: 'GLOBAL'),
    ]) {
        global = load env.GLOBAL
    }

    stage('Checkout') {
        checkout scm
    }

    withEnv([
        "COMMIT_SHA=${env.ghprbActualCommit}",
        "IMAGE_TAG=${env.ghprbActualCommit.substring(0, 8)}",
        "PROJECT_NAME=delta-sharing-${env.BUILD_NUMBER}",
        "ROOTDIR=${global.HOST_WORKSPACE}"]) {
        try {
            stage('Build image') {
                ansiColor('xterm') {
                    // DEVOPS-6131: sbt can't reach Maven Central from jenkins-eng (shared egress IP
                    // is 429'd), so ci/sbt-mirror/setup.sh points sbt at the virtana-zing Artifact
                    // Registry proxy before the build. Auth = short-lived token minted from
                    // gcr_push_key. All the logic + config templates live in ci/sbt-mirror/.
                    withCredentials([file(credentialsId: 'gcr_push_key', variable: 'AR_KEY_FILE')]) {
                        sh("ci/sbt-mirror/setup.sh && . ./.ar-token.env && ${MAKE} build")
                    }
                }
            }

            stage("Validate Manifests") {
                build job: env.GLOBAL_KUSTOMIZE_PROOFING_JOB,
                    wait: true,
                    propagate: true,
                    parameters: [
                        text(name: 'SERVICE_NAME', value: "delta-sharing"),
                        text(name: 'SERVICE_GIT', value: "https://github.com/zenoss/delta-sharing"),
                        text(name: 'SERVICE_GIT_SHA', value: env.GIT_BRANCH),
                        text(name: 'UPSTREAM_JOB_NAME', value: env.JOB_NAME),
                        text(name: 'UPSTREAM_JOB_NUMBER', value: env.BUILD_NUMBER),
                        text(name: 'UPSTREAM_JOB_URL', value: env.BUILD_URL),
                    ]
            }

        } finally {
            stage ('Clean test environment') {
                // remove token-bearing files setup.sh wrote (HOME + workspace)
                sh('rm -f "$HOME/.config/coursier/credentials.properties" ./.ar-token.env || true')
                sh("${MAKE} clean")
            }
        }
    }
}
